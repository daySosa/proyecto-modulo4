{
  "name": "proyecto-modulo4",
  "version": "1.0.0",
  "description": "Proyecto Módulo 4: Bootstrap, jQuery, Sass/Less y NPM Scripts",
  "scripts": {
    "scss": "sass css/styles.scss css/styles.css",
    "watch:scss": "onchange \"css/*.scss\" -- npm run scss",
    "clean": "rimraf distri",
    "copyfiles": "copyfiles index.html css/styles.css js/script.js distri",
    "imagemin": "imagemin img/* --out-dir=distri/img",
    "build": "npm run clean && npm run scss && npm run copyfiles"
  },
  "license": "ISC",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "onchange": "^7.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1"
  }
}
